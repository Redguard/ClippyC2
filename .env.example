CLIPPYC2_DOMAIN="your.domain.example"
CLIPPYC2_OPERATOR_PASSWORD="your_operator_password_here"
CLIPPYC2_BROWSER_PASSWORD="your_browser_password_here"
CLIPPYC2_ENCRYPTION_KEY="replace_with_base64_encoded_32_byte_key"
CLIPPYC2_HOST=0.0.0.0
CLIPPYC2_PORT=5000
CLIPPYC2_SSL=0
CLIPPYC2_POLL_INTERVAL=60
CLIPPYC2_PUSH_RATE_LIMIT=30
CLIPPYC2_DB=/app/data/clippyc2.db
FLASK_DEBUG=0